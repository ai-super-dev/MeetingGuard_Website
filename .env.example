# The web agenda's connection to the app's Firebase project. Copy this file to
# .env.local and fill it in, then build. These values are public: they identify
# the project, and access is enforced by sign-in and the Firestore rules.
# Without them, /app runs as a preview with sample data kept in the browser.
#
# Firebase console > Project settings > General > Your apps > Web app > Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=meetingguard-ai-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=meetingguard-ai-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Must match where the app's functions are deployed.
NEXT_PUBLIC_FUNCTIONS_REGION=us-central1

# "1" shows Continue with Apple. Needs a Services ID in the Firebase Apple provider first.
NEXT_PUBLIC_APPLE_SIGN_IN=
