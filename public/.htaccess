# Hostinger (Apache / LiteSpeed). Copied into ./out by every build.
# Every page is a folder with an index.html (/es/ is es/index.html), so no
# rewrite is needed to find a page; the server adds the final slash itself.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Every rule tests the full address (%{REQUEST_URI}), never the RewriteRule
# pattern: Hostinger's LiteSpeed matches the pattern against the part after a
# real folder (for /es/terms-of-service/ it sees only "terms-of-service/"),
# which sent Spanish pages to their English twins.

# old addresses
RewriteCond %{REQUEST_URI} ^/privacy/?$
RewriteRule ^ /privacy-policy/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/terms/?$
RewriteRule ^ /terms-of-service/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/es/privacy/?$
RewriteRule ^ /es/privacy-policy/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/es/terms/?$
RewriteRule ^ /es/terms-of-service/ [R=301,L]

# a page address without its final slash gets one (most servers already do this)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ %{REQUEST_URI}/ [R=301,L]

# the social preview image has no file extension
<FilesMatch "^opengraph-image">
  ForceType image/png
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; media-src 'self'; connect-src 'self' https://*.cloudfunctions.net https://*.run.app https://www.google-analytics.com https://*.analytics.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  <FilesMatch "\.(png|jpg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # scripts, styles and fonts all live in _next/static and have content hashes in their names
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
